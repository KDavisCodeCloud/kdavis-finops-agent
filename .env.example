DATABASE_URL=
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
FINOPS_AWS_ACCOUNT_ID=
# This service's OWN AWS identity -- used to call sts:AssumeRole into
# customer accounts. Needs no permissions beyond sts:AssumeRole itself;
# create a dedicated least-privilege IAM user for this, never reuse a
# personal/admin AWS credential.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region used for the assumed-role session (EC2/RDS/S3/Security Hub need
# one explicitly -- a session built from raw credentials has none by default).
AWS_DEFAULT_REGION=us-east-1
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
